pageStyles: |
  /* --- Hero collage --- */
  .hero-collage {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto auto;
    gap: 8px;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .hero-collage__main {
    grid-row: 1 / 3;
    width: 100%;
    height: 420px;
    object-fit: cover;
  }
  .hero-collage__side {
    width: 100%;
    height: 206px;
    object-fit: cover;
  }

  /* --- Trust strip --- */
  .trust-strip {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5) var(--space-8);
    align-items: center;
    padding: var(--space-5) var(--space-6);
    background: var(--surface-mute);
    border-radius: var(--radius-md);
    margin-top: var(--space-7);
  }
  .trust-strip__stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .trust-strip__value {
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--ink);
    line-height: 1;
  }
  .trust-strip__label {
    font-size: var(--text-xs);
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .trust-strip__divider {
    width: 1px;
    height: 32px;
    background: var(--rule-bold);
    flex-shrink: 0;
  }

  /* --- Service cards grid --- */
  .service-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }
  .service-card {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--rule);
    background: var(--surface);
    transition: box-shadow var(--transition-base), transform var(--transition-base);
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
  }
  .service-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-3px);
    text-decoration: none;
  }
  .service-card__img {
    width: 100%;
    height: 200px;
    object-fit: cover;
  }
  .service-card__body {
    padding: var(--space-5);
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .service-card__title {
    font-size: var(--text-h3);
    font-weight: 700;
    color: var(--ink);
  }
  .service-card__desc {
    font-size: var(--text-sm);
    color: var(--ink-muted);
    line-height: var(--lh-base);
    flex: 1;
  }
  .service-card__cta {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink);
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .service-card__cta::after {
    content: '→';
  }

  /* --- Photo grid (portfolio) --- */
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .photo-grid__img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    display: block;
    transition: opacity var(--transition-fast);
  }
  .photo-grid__img:hover { opacity: 0.88; }

  /* --- Pillar cards (Waarom Alfa) --- */
  .pillar-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }
  .pillar-card {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--rule);
    background: var(--surface);
  }
  .pillar-card__img {
    width: 100%;
    height: 180px;
    object-fit: cover;
  }
  .pillar-card__body {
    padding: var(--space-5);
  }
  .pillar-card__tag {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: #6B5B00;
    background: #FFF7CC;
    border-radius: var(--radius-pill);
    padding: 3px 10px;
    margin-bottom: var(--space-3);
  }
  .pillar-card__title {
    font-size: var(--text-h3);
    font-weight: 700;
    margin-bottom: var(--space-3);
  }
  .pillar-card__desc {
    font-size: var(--text-sm);
    color: var(--ink-muted);
    line-height: var(--lh-base);
  }

  /* --- Step list (Werkwijze teaser) --- */
  .step-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    counter-reset: step;
  }
  .step-item {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }
  .step-item::before {
    counter-increment: step;
    content: counter(step);
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--brand);
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 2px;
  }

  /* --- Brand pills / sector pills --- */
  .pill-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--rule-bold);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--ink);
    background: var(--surface);
  }
  .pill--brand {
    background: var(--brand);
    border-color: var(--brand);
    font-weight: 700;
  }

  /* --- Review cards teaser --- */
  .review-teaser {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5);
  }
  .review-item {
    background: var(--surface-soft);
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    padding: var(--space-5);
  }
  .review-item__stars {
    color: var(--brand);
    font-size: 18px;
    margin-bottom: var(--space-3);
  }
  .review-item__quote {
    font-size: var(--text-base);
    font-style: italic;
    color: var(--ink-soft);
    line-height: var(--lh-base);
    margin-bottom: var(--space-4);
  }
  .review-item__author {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink);
  }
  .review-item__role {
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }

  /* --- Aggregate score display --- */
  .agg-score {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }
  .agg-score__num {
    font-size: clamp(48px, 6vw, 72px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .agg-score__stars {
    font-size: 28px;
    color: var(--brand);
    line-height: 1;
  }
  .agg-score__label {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  /* --- FAQ inline --- */
  .faq-inline {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid var(--rule);
  }
  .faq-inline__item {
    border-bottom: 1px solid var(--rule);
    padding: var(--space-5) 0;
  }
  .faq-inline__q {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--ink);
    margin-bottom: var(--space-3);
  }
  .faq-inline__a {
    font-size: var(--text-sm);
    color: var(--ink-muted);
    line-height: var(--lh-base);
  }

  /* --- Final CTA card --- */
  .cta-card {
    background: var(--ink);
    color: var(--surface);
    border-radius: var(--radius-lg);
    padding: var(--space-9) var(--space-8);
    text-align: center;
  }
  .cta-card .section-title {
    color: var(--surface);
  }
  .cta-card .section-title::before {
    background: var(--brand);
  }

  /* --- Responsive --- */
  @media (max-width: 900px) {
    .hero-collage { grid-template-columns: 1fr; }
    .hero-collage__main { height: 280px; grid-row: auto; }
    .hero-collage__side { height: 180px; }
    .service-grid, .pillar-grid { grid-template-columns: 1fr; }
    .photo-grid { grid-template-columns: repeat(2, 1fr); }
    .photo-grid__img { height: 160px; }
    .review-teaser { grid-template-columns: 1fr; }
    .trust-strip { gap: var(--space-4); }
    .trust-strip__divider { display: none; }
  }
  @media (max-width: 600px) {
    .photo-grid { grid-template-columns: repeat(2, 1fr); }
    .agg-score { flex-direction: column; align-items: flex-start; gap: var(--space-2); }
  }
