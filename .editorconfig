# EditorConfig — https://editorconfig.org
# Zorgt voor consistente formatting across alle editors en OS'en

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{py,sh}]
indent_size = 4

[Makefile]
indent_style = tab

[{_headers,_redirects,robots.txt,humans.txt,llms.txt,security.txt}]
insert_final_newline = true
trim_trailing_whitespace = true
