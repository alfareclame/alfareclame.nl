          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#lumen-lux", "name": "Lumen / Lux", "description": "Lumen = totale lichtstroom van een lichtbron; Lux = ontvangen licht per m² op een vlak. Een doosletter van 80 cm hoog stoot circa 800–1200 lumen uit.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#nsvv", "name": "NSVV-norm", "description": "Richtlijnen Lichthinder van de Nederlandse Stichting voor Verlichtingskunde — maximale luminantie van verlichte reclame om hinder voor omwonenden te voorkomen.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#transformator", "name": "Transformator / Driver", "description": "Elektronische voeding die 230 V netspanning omzet naar 12 V of 24 V DC voor LED-modules. IP65 of IP67 buiten verplicht; merken Mean Well, Osram, Slim Tronic.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#ip-rating", "name": "IP-rating", "description": "Ingress Protection-codering (IEC 60529): cijfer 1 = stof, cijfer 2 = water. IP65 = stofdicht en spatwaterdicht buiten; IP67 = tijdelijk onderdompelbaar.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#cmyk-rgb", "name": "CMYK / RGB", "description": "CMYK = subtractief kleurmodel voor druk (cyaan, magenta, geel, zwart); RGB = additief kleurmodel voor schermen (rood, groen, blauw). Print altijd in CMYK aanleveren.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#pantone-pms", "name": "Pantone PMS", "description": "Pantone Matching System — wereldwijde standaardbibliotheek van vooraf gemengde inkten (bv. PMS 186 C). Enige betrouwbare brand-referentie over media en leveranciers.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#spotkleur", "name": "Spotkleur", "description": "Aparte voorgemengde inktkleur (vaak Pantone) die als extra draaiing op een drukpers wordt aangebracht naast CMYK. Onmisbaar voor metallic, fluor en exacte huisstijltinten.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#kleurproef", "name": "Kleurproef", "description": "Fysieke proefdruk op het uiteindelijke substraat (vinyl, dibond, plexiglas) om kleurmatch en gamut-conversie te controleren vóór seriële productie.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#delta-e", "name": "ΔE-waarde (Delta-E)", "description": "Wetenschappelijke maat voor kleurverschil in CIE-Lab-ruimte. ΔE < 1 niet zichtbaar, < 3 acceptabel voor signage, < 2 vereist voor logo-kritische uitingen.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#solvent-print", "name": "Solvent-print", "description": "Klassieke inkjettechniek met oplosmiddel-gebaseerde inkten. Verdwijnt langzaam wegens VOC-emissies; vervangen door eco-solvent en latex bij moderne shops.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#latex-print", "name": "Latex-print", "description": "HP-technologie met water-gebaseerde latex-inkten — geurarm, direct droog, bredere kleurgamut dan eco-solvent. Geschikt voor wandbekleding en binnen-signage.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#uv-print", "name": "UV-print", "description": "Direct-to-substrate printtechniek waarbij UV-inkt onder UV-licht hardt op vrijwel elk materiaal (dibond, hout, glas, metaal). Sterk verzadigd resultaat, krasvast.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#eco-solvent", "name": "Eco-solvent", "description": "Moderne inkjettechniek met laag-VOC oplosmiddel-inkt (Roland TrueVIS, Mimaki SUV). De facto standaard voor signage- en wrap-print in Nederlandse shops.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#dpi-ppi", "name": "DPI / PPI", "description": "Dots Per Inch (printer-resolutie) versus Pixels Per Inch (digitale beeld-resolutie). Voor grootformaat signage geldt 100–150 DPI op kijkafstand 3+ m als praktisch optimum.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#welstandscommissie", "name": "Welstandscommissie", "description": "Onafhankelijk gemeentelijk adviesorgaan dat reclame-uitingen op gevels beoordeelt op visuele kwaliteit. In Rotterdam: Commissie Welstand & Monumenten.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#omgevingsvergunning-reclame", "name": "Omgevingsvergunning reclame", "description": "Aanvraag bij gemeente voor permanente gevelreclame > 0,5 m² of verlichting. Geregeld via Omgevingswet/Wabo; doorlooptijd 8 weken regulier of 26 weken uitgebreid.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#beschermd-stadsgezicht", "name": "Beschermd stadsgezicht", "description": "Rijksbeschermde gebieden (in Rotterdam o.a. Delfshaven, Kralingen West) waar reclame strenger wordt getoetst op materiaal, kleur en plaatsing.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#monumentaal-pand", "name": "Monumentaal pand", "description": "Rijks- of gemeentelijk monument; signage vereist instemming Rijksdienst voor het Cultureel Erfgoed of monumentencommissie. Geen permanente boringen in oorspronkelijke materialen.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#nsvv-richtlijn", "name": "NSVV-richtlijn lichthinder", "description": "Lichthinder-richtlijnen NSVV (2020) — luminantie-maxima voor verlichte reclame onderverdeeld in gebiedstypen E1 (donker) tot E4 (centrum).", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#frontboord", "name": "Frontboord / Bovenlicht", "description": "Horizontale plaat boven winkelpui waarop bedrijfsnaam wordt gemonteerd. Standaardhoogte 50–80 cm; basisdrager voor doosletters of belettering.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#gevelplaat", "name": "Gevelplaat", "description": "Dragerplaat (meestal dibond 3 mm) voor montage tegen muur of frontboord, voorzien van geprinte of beletterde laag. Levensduur 7–10 jaar buiten.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#standaardbord", "name": "Standaardbord", "description": "Vrijstaand reclamebord op poot of frame, geplaatst langs invalsweg of parkeerterrein. Verschilt van gevelreclame omdat het niet aan een bouwwerk vast is.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#vlakreclame", "name": "Vlakreclame", "description": "Tweedimensionale belettering of bedrukte plaat tegen gevel, zonder reliëf of verlichting. Goedkoopste vorm gevelsignage, vaak gebruikt door MKB.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#hoogwerker", "name": "Hoogwerker", "description": "Mobiele werkbak (schaarlift, knikarm of telescoop) voor montage op gevels > 3,5 m. VCA-gecertificeerd personeel verplicht; dagverhuur €250–€450 Rotterdam-regio.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#vca", "name": "VCA", "description": "Veiligheid Checklist Aannemers — gecertificeerd veiligheidssysteem verplicht voor werk in industriële, haven- en chemische omgevingen. Alfa Reclame: VCA-Basis.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#silobelettering", "name": "Silobelettering", "description": "Grootformaat belettering op cilindrische opslag-silo's (graan, cement, chemie). Vraagt heatgun-conforme cast vinyl en hoogwerker; vaak 4–8 m letterhoogte.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#imo", "name": "IMO-markering", "description": "International Maritime Organization-voorschriften voor scheepsmarkering: IMO-nummer, MARPOL-tekens, ladingaanduiding. Vereist marine-grade vinyl.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#marine-grade-vinyl", "name": "Marine-grade vinyl", "description": "Cast vinyl met extra zoutwater- en UV-bestendigheid (3M Scotchcal 7725-Marine, Avery Marine MPI). Toepassing op binnenvaart, zeevracht en offshore.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#reefer-container", "name": "Reefer-container", "description": "Gekoelde 20'/40' zeecontainer met koel-/vrieseenheid. Belettering vraagt cast vinyl bestand tegen temperatuur-cyclus van −25 °C tot +30 °C en hogedrukreiniging.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#dot-contour", "name": "DOT/EU contourmarkering", "description": "Verplichte reflecterende contourstreep op vrachtwagens en aanhangers > 3,5 t volgens UNECE-104 / DOT-FMVSS. Standaard 3M Diamond Grade of Reflexite GP-340.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#atex", "name": "ATEX-zone", "description": "EU-richtlijn 2014/34/EU voor explosiegevaarlijke gebieden (raffinaderij, gasopslag). Signage in zone 0/1/2 vraagt anti-statische vinyl en aardingscertificering.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#mockup", "name": "Mockup / Visual", "description": "Digitale visualisatie van het ontwerp op een foto van de werkelijke gevel, ruit of voertuig. Standaard onderdeel van offerte; geeft klant kijk op eindresultaat.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#bewijsproef", "name": "Bewijsproef", "description": "Definitieve goedgekeurde proef die als referentie geldt voor seriële productie. Klant ondertekent; afwijking in productie binnen ΔE-tolerantie is grond voor reproductie.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#designbrief", "name": "Designbrief", "description": "Schriftelijke opdrachtbeschrijving met huisstijl-elementen, kleurcodes, materiaal-voorkeuren, kijkafstand en deadline. Basis voor ontwerp- en productieproces.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#productieplaat", "name": "Productieplaat", "description": "Vector-PDF/EPS bestand met snijlijnen, bleed-marges en kleur-separaties klaar voor plotter of RIP-software. Schaal 1:1 op werkelijke afmetingen.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#plotter", "name": "Plotter / Snijplotter", "description": "CNC-aangestuurde snijmachine (Roland GS-24, Summa S-Class) die vinyl-vellen tot 137 cm breed met chirurgische precisie in vorm snijdt.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#onderlaag", "name": "Onderlaag (substrate prep)", "description": "Voorbereidende reiniging en ontvetting van het oppervlak met IPA (isopropanol) en lintvrije doek. Cruciaal voor hechting; ontbreken is hoofdoorzaak van loslatende vinyl.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#levertijd", "name": "Levertijd", "description": "Periode tussen goedkeuring proef en montage. Standaard 5–10 werkdagen voor raambelettering, 7–14 voor autoreclame, 10–20 voor gevelreclame met vergunning.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#spoedopdracht", "name": "Spoedopdracht", "description": "Productie binnen 48–72 uur met express-meerprijs van 25–50%. Mogelijk voor raambelettering en kleine autoreclame; gevelreclame met vergunning is niet versnelbaar.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#express-meerprijs", "name": "Express-meerprijs", "description": "Toeslag van 25–50% op standaard-offerte voor spoedopdrachten. Dekt overuren, voorrang op planning en eventueel extern uitgevoerde print.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#maintenance", "name": "Maintenance (onderhoud)", "description": "Periodieke inspectie, reiniging en kleine reparatie van bestaande signage. Wij adviseren jaarlijkse check op gevelreclame; LED-modules vervangen na 8–10 jaar branduur.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#welstandsadvies", "name": "Welstandsadvies", "description": "Schriftelijk advies van welstandscommissie over esthetische kwaliteit van voorgenomen reclame. Verplichte input bij omgevingsvergunning; niet-bindend maar zwaarwegend.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#garantietermijn", "name": "Garantietermijn", "description": "Termijn waarbinnen leverancier gratis defecten herstelt. Alfa Reclame: 2 jaar werkgarantie op montage + fabrieksgarantie op materialen (vinyl 5–7 jaar, LED 5 jaar).", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#productgarantie", "name": "Productgarantie", "description": "Fabrieksgarantie op het materiaal zelf (vinyl, LED-module, voeding). Onafhankelijk van werkgarantie; voorwaarde is correcte applicatie volgens datasheet.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#hechtingsgarantie", "name": "Hechtingsgarantie", "description": "Werkgarantie dat vinyl niet binnen X jaar loslaat door applicatiefout. Alfa Reclame: 2 jaar op alle vinyl-montage onder normale gebruiksomstandigheden.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#kleurvastheid-garantie", "name": "Kleurvastheid-garantie", "description": "Fabrieksgarantie op UV-stabiliteit van pigmenten. Voor A-merk cast vinyl typisch 5–7 jaar tegen vervaging, geel-wording en barsten — mits laminaat toegepast.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#ral-kleur", "name": "RAL-kleurensysteem", "description": "Europese kleurstandaard (RAL Classic, RAL Design) voor lakwerk, poedercoating en gevelafwerking. RAL 9005 = diepzwart; RAL 9016 = wit.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#bleed", "name": "Bleed (afloop)", "description": "Extra 3–5 mm rondom de uiteindelijke snijlijn waarop achtergrondkleur of beeld doorloopt. Voorkomt witte randen na snijden of frezen.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#raster-vector", "name": "Raster vs. vector", "description": "Rasterbeelden (JPG, PNG, TIFF) bestaan uit pixels en verliezen scherpte bij vergroting; vectorbeelden (AI, EPS, PDF, SVG) zijn wiskundige vormen en schaalbaar.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#cnc-frezen", "name": "CNC-frezen", "description": "Computergestuurd freswerk op aluminium, acryl of dibond voor 3D-letters, freesletters en gevelnaambordjes. Tolerantie 0,1 mm.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#laserfrees", "name": "Lasersnijden", "description": "CO2- of fiber-lasersnijden van acryl, dunne metalen en hout voor scherpe letters en logo's. Sneller en preciezer dan frezen, maar beperkt tot vlakke materialen.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#poedercoating", "name": "Poedercoating", "description": "Industrieel laksysteem waarbij elektrostatisch poeder op metaal wordt aangebracht en uitgehard in een oven (180 °C). Levensduur 15+ jaar buiten in elke RAL-kleur.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" },
          { "@type": "DefinedTerm", "@id": "https://alfareclame.nl/vakwoordenboek/#vhb-tape", "name": "VHB-tape (3M)", "description": "Very High Bond dubbelzijdig acrylatentape van 3M voor onzichtbare montage van letters en panelen aan gevels. Vervangt schroeven; UV- en weerbestendig 20+ jaar.", "inDefinedTermSet": "https://alfareclame.nl/vakwoordenboek/#termset" }
        ]
      }
    ]
  }
---

