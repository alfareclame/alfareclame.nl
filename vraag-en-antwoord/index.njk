    border-radius: 999px;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink, #1d1d1f);
  }
  .qa-jump-strip ul li a:hover { background: var(--brand, #ff6b35); color: #fff; }

  .qa-bluf {
    background: var(--soft, #f7f7f8);
    border-left: 4px solid var(--brand, #ff6b35);
    padding: 20px 24px;
    margin: 24px 0 32px;
    border-radius: 0 8px 8px 0;
    font-size: 1.05rem;
    line-height: 1.6;
  }
