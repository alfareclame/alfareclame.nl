  .service-detail .tier-table { width: 100%; border-collapse: collapse; font-size: 14px; margin-top: 8px; }
  .service-detail .tier-table th { padding: 8px 0; text-align: left; font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-subtle); border-bottom: 1px solid var(--rule); }
  .service-detail .tier-table td { padding: 8px 0; border-bottom: 1px solid var(--rule); }
  .service-detail .tier-table tr:last-child td { border-bottom: none; }
  .service-detail .tier-table .t-price { font-variant-numeric: tabular-nums; white-space: nowrap; font-weight: 500; }
  .service-detail .sd-link { display: inline-block; margin-top: 12px; font-size: 13px; color: var(--ai-accent); text-decoration: none; font-weight: 500; }
  .service-detail .sd-link:hover { text-decoration: underline; }

  .faq { margin-top: 48px; }
  .faq-item { border-bottom: 1px solid var(--rule); padding: 22px 0; }
