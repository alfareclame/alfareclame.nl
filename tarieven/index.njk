  .faq-a { font-size: 16px; line-height: 1.65; color: var(--ink-muted); }

  .final-cta { margin: 72px 0 40px; padding: 52px 48px; background: var(--ink); color: var(--white); border-radius: 24px; text-align: center; }
  .final-cta h3 { font-size: clamp(26px, 4vw, 36px); font-weight: 500; letter-spacing: -0.025em; line-height: 1.15; margin-bottom: 14px; }
  .final-cta h3 .light { font-weight: 200; color: rgba(255,255,255,0.6); }
  .final-cta p { font-size: 16px; color: rgba(255,255,255,0.7); max-width: 520px; margin: 0 auto 28px; line-height: 1.5; }
  .final-cta-actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .btn-white { padding: 14px 28px; background: var(--white); color: var(--ink); border-radius: 100px; font-size: 14px; font-weight: 500; text-decoration: none; transition: all 0.2s; display: inline-flex; align-items: center; gap: 8px; }
  .btn-white:hover { transform: translateY(-2px); box-shadow: 0 10px 30px rgba(255,255,255,0.15); }
  .btn-outline { padding: 14px 28px; background: transparent; color: var(--white); border: 1px solid rgba(255,255,255,0.25); border-radius: 100px; font-size: 14px; font-weight: 500; text-decoration: none; transition: all 0.2s; }
  .btn-outline:hover { border-color: var(--white); background: rgba(255,255,255,0.05); }
  @media (max-width: 720px) { .final-cta { padding: 40px 28px; } }

  footer { padding: 48px 40px; border-top: 1px solid var(--rule); text-align: center; font-size: 13px; color: var(--ink-subtle); }
