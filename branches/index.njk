    /* Branch grid: 3 cols desktop, 2 tablet, 1 phone */
    .branches-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-6);
    }

    /* Pill row for use-cases */
    .pill-row {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      margin-top: var(--space-3);
    }

    .pill {
      display: inline-block;
      font-size: var(--text-xs);
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      background: var(--surface-mute);
      color: var(--ink-muted);
      padding: 4px 10px;
      border-radius: var(--radius-pill);
      border: 1px solid var(--rule-bold);
      white-space: nowrap;
    }

    /* Branch card: photo top + body */
    .branch-card {
      background: var(--surface);
      border: 1px solid var(--ink);
      border-radius: var(--radius-lg);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      position: relative;
      transition: transform var(--transition-base), box-shadow var(--transition-base);
    }

    .branch-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-lg);
    }

    .branch-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: var(--brand);
      transform: scaleX(0);
      transform-origin: left center;
      transition: transform var(--transition-base);
      z-index: 1;
    }

    .branch-card:hover::before {
      transform: scaleX(1);
    }

    .branch-card::after {
      content: '';
      position: absolute;
      top: 0;
      right: 0;
      width: 28px;
      height: 28px;
      background: var(--brand);
      clip-path: polygon(100% 0, 100% 100%, 0 0);
      z-index: 2;
    }

    .branch-card__image-wrap {
      position: relative;
      width: 100%;
      aspect-ratio: 4 / 3;
      overflow: hidden;
    }

    .branch-card__image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform var(--transition-slow);
    }

    .branch-card:hover .branch-card__image {
      transform: scale(1.03);
    }

    .branch-card__body {
      padding: var(--space-5);
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }

    .branch-card__title {
      font-size: var(--text-h3);
      font-weight: 700;
      letter-spacing: -0.01em;
      color: var(--ink);
      margin: 0;
    }

    .branch-card__desc {
      font-size: var(--text-base);
      color: var(--ink-muted);
      line-height: var(--lh-base);
      flex: 1;
    }

    /* Niche-cases tiles */
    .niche-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: var(--space-4);
      margin-top: var(--space-6);
    }

    .niche-tile {
      background: var(--surface);
      border: 1px solid var(--rule-bold);
      border-radius: var(--radius-md);
      padding: var(--space-5) var(--space-4);
      text-align: center;
    }

    .niche-tile__name {
      font-size: var(--text-sm);
      font-weight: 700;
      color: var(--ink);
      margin-bottom: var(--space-2);
    }

    .niche-tile__sub {
      font-size: var(--text-xs);
      color: var(--ink-muted);
      line-height: 1.45;
    }

    @media (max-width: 880px) {
      .branches-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 480px) {
      .branches-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .branch-card:hover .branch-card__image {
        transform: none;
      }
    }
