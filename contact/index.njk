    font-weight: 600;
    color: var(--ink);
    line-height: 1.45;
  }
  .bedrijf-item__value a {
    color: var(--brand);
    text-decoration: none;
  }
  .bedrijf-item__value a:hover {
    text-decoration: underline;
  }

  /* Werkgebied tags */
  .werkgebied-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  .werkgebied-tag {
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--rule-bold);
    border-radius: 100px;
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
  }
  .werkgebied-tag--primary {
    background: var(--brand);
    border-color: var(--brand);
    color: var(--ink);
  }

  /* Map section */
  .map-wrapper {
    margin-top: var(--space-6);
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--ink);
  }

  /* Final CTA buttons */
  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    justify-content: center;
    margin-top: var(--space-7);
  }
pageScripts: |
  <script>
  (function () {
    'use strict';

    /* --- Mobile nav toggle --- */
    var toggle = document.getElementById('nav-toggle');
    var mobileNav = document.getElementById('mobile-nav');

    if (toggle && mobileNav) {
      toggle.addEventListener('click', function () {
        var isOpen = mobileNav.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        toggle.setAttribute('aria-label', isOpen ? 'Menu sluiten' : 'Menu openen');
        document.body.style.overflow = isOpen ? 'hidden' : '';
      });

      document.addEventListener('click', function (e) {
        if (!toggle.contains(e.target) && !mobileNav.contains(e.target) && mobileNav.classList.contains('is-open')) {
          mobileNav.classList.remove('is-open');
          toggle.setAttribute('aria-expanded', 'false');
          toggle.setAttribute('aria-label', 'Menu openen');
          document.body.style.overflow = '';
        }
      });
    }

  })();

  // ===== Contact form — POST /api/contact (Telegram + Brevo), verbatim from index.html =====
  const contactForm = document.getElementById('contactForm');
  const contactStatus = document.getElementById('contactFormStatus');
  const DEFAULT_STATUS_TEXT = contactStatus ? contactStatus.textContent : '';

  function setStatus(msg, kind) {
    if (!contactStatus) return;
    contactStatus.textContent = msg;
    contactStatus.dataset.state = kind || '';
  }

  const ERROR_MESSAGES = {
    rate_limited: 'Te veel aanvragen achter elkaar. Probeer over 10 minuten opnieuw, of bel ons direct op 06 24 74 15 97.',
    invalid_email: 'Het opgegeven e-mailadres is ongeldig.',
    invalid_phone: 'Het opgegeven telefoonnummer is ongeldig.',
    missing_fields: 'Vul alle velden in: naam, telefoon, e-mail en bericht.',
    payload_too_large: 'Uw bericht is te lang. Kort het in tot circa 4000 tekens.',
    telegram_failed: 'Tijdelijk technisch probleem met versturen. Bel of WhatsApp ons direct op 06 24 74 15 97.',
    telegram_unreachable: 'Tijdelijk technisch probleem. Bel of WhatsApp ons direct op 06 24 74 15 97.',
    server_misconfigured: 'Server tijdelijk niet beschikbaar. Bel of WhatsApp ons direct op 06 24 74 15 97.',
    network: 'Geen verbinding. Controleer uw internet en probeer opnieuw. Of bel direct: 06 24 74 15 97.',
    default: 'Versturen mislukt. Probeer het opnieuw of bel ons direct op 06 24 74 15 97.',
  };

  if (contactForm) {
    contactForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = contactForm.querySelector('button[type="submit"]');
      const fd = new FormData(contactForm);
      const payload = {
        name: (fd.get('name') || '').toString().trim(),
        phone: (fd.get('phone') || '').toString().trim(),
        email: (fd.get('email') || '').toString().trim(),
        subject: (fd.get('service') || '').toString().trim(),
        message: (fd.get('message') || '').toString().trim(),
        source_url: window.location.href,
        _hp: (fd.get('_hp') || '').toString(),
      };

      if (!payload.name || !payload.email || !payload.phone || !payload.message) {
        setStatus('Vul alle velden in: naam, telefoon, e-mail en bericht.', 'error');
        return;
      }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(payload.email)) {
        setStatus('Het opgegeven e-mailadres is ongeldig.', 'error');
        return;
      }
      const phoneDigits = payload.phone.replace(/\D/g, '');
      if (phoneDigits.length < 8 || phoneDigits.length > 18) {
        setStatus('Het opgegeven telefoonnummer is ongeldig.', 'error');
        return;
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.dataset._label = submitBtn.textContent;
        submitBtn.textContent = 'Versturen…';
      }
      setStatus('Bezig met versturen…', 'pending');

      let result = { ok: false, error: 'default' };
      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const out = await res.json().catch(() => ({}));
        result.ok = !!(res.ok && out.ok);
        result.error = out.error || (res.ok ? null : 'default');
      } catch (_) {
        result.ok = false;
        result.error = 'network';
      }

      if (result.ok) {
        setStatus('Bedankt! Uw aanvraag is verstuurd. We reageren binnen één werkdag.', 'success');
        contactForm.reset();
      } else {
        const msg = ERROR_MESSAGES[result.error] || ERROR_MESSAGES.default;
        setStatus(msg, 'error');
      }

      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = submitBtn.dataset._label || 'Gratis offerte aanvragen →';
      }
      setTimeout(() => {
        if (contactStatus && contactStatus.dataset.state !== 'success') {
          setStatus(DEFAULT_STATUS_TEXT, '');
        }
      }, 12000);
    });
  }
  </script>
