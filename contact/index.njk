  /* ===== Contact page local styles ===== */

  /* Channel grid */
  .channel-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-8);
  }
  .channel-card {
    background: var(--surface);
    border: 1px solid var(--rule-bold);
    border-radius: 16px;
    padding: var(--space-6) var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .channel-card:hover {
    border-color: var(--brand);
    box-shadow: 0 4px 24px rgba(0,0,0,0.06);
  }
  .channel-card__icon {
    font-size: 28px;
    line-height: 1;
  }
  .channel-card__label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .channel-card__title {
    font-size: 18px;
    font-weight: 700;
    color: var(--ink);
    margin: 0;
  }
  .channel-card__link {
    font-size: 17px;
    font-weight: 600;
    color: var(--brand);
    text-decoration: none;
    word-break: break-all;
  }
  .channel-card__link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .channel-card__sub {
    font-size: 13px;
    color: var(--ink-muted);
    line-height: 1.5;
  }
  .channel-card--whatsapp {
    border-color: #25D366;
  }
  .channel-card--whatsapp .channel-card__link {
    color: #1a9e4c;
  }

  /* Form section two-col */
  .form-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-10);
    align-items: start;
  }
  @media (max-width: 768px) {
    .form-layout {
      grid-template-columns: 1fr;
    }
  }

  /* What happens next block */
  .next-steps {
    border: 1px solid var(--rule);
    border-radius: 16px;
    padding: var(--space-7) var(--space-6);
  }
  .next-steps h3 {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: var(--space-5);
    color: var(--ink);
  }
  .next-step {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    margin-bottom: var(--space-5);
  }
  .next-step:last-child {
    margin-bottom: 0;
  }
  .next-step__num {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    background: var(--brand);
    color: var(--ink);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 800;
  }
  .next-step__text {
    font-size: 15px;
    color: var(--ink-muted);
    line-height: 1.55;
  }
  .next-step__text strong {
    color: var(--ink);
    display: block;
    margin-bottom: 2px;
  }

  /* Opening hours table */
  .hours-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: var(--space-5);
  }
  .hours-table th,
  .hours-table td {
    text-align: left;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--rule);
    font-size: 15px;
  }
  .hours-table th {
    font-weight: 700;
    color: var(--ink);
  }
  .hours-table td {
    color: var(--ink-muted);
  }
  .hours-table tr:last-child td,
  .hours-table tr:last-child th {
    border-bottom: none;
  }
  .hours-badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: 20px;
    background: #d4f8e2;
    color: #1a6b3a;
  }
  .hours-badge--closed {
    background: var(--rule);
    color: var(--ink-muted);
  }

  /* Bedrijfsgegevens */
  .bedrijf-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-5);
  }
  .bedrijf-item {
    padding: var(--space-5);
    border: 1px solid var(--rule);
    border-radius: 12px;
  }
  .bedrijf-item__label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: var(--space-2);
  }
  .bedrijf-item__value {
