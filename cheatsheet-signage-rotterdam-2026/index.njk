<script>
(function(){
  var VAPID_PUBLIC = 'BIR1hddoizF6wVfuaEDihW-JAm2FIUStVo_S1_yCI0WBky9Tyf81gvioGtoN0HFCTLHIxF8akpKYAi5922lGnaw';
  var btn = document.getElementById('push-opt-in-cs');
  if (!btn || !('serviceWorker' in navigator) || !('PushManager' in window)) return;
  if (Notification.permission === 'default') btn.style.display = 'inline-block';
  btn.addEventListener('click', async function() {
    try {
      var perm = await Notification.requestPermission();
      if (perm !== 'granted') return;
      var reg = await navigator.serviceWorker.ready;
      var sub = await reg.pushManager.subscribe({
        userVisibleOnly: true,
        applicationServerKey: urlBase64ToUint8Array(VAPID_PUBLIC)
      });
      await fetch('/api/push-subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(sub.toJSON())
      });
      btn.style.display = 'none';
      alert('Bedankt! Je ontvangt een melding bij versie 2.0.');
    } catch(e) { console.warn('Push subscribe failed:', e); }
  });
  function urlBase64ToUint8Array(b) {
    var pad = '='.repeat((4 - b.length % 4) % 4);
    var base64 = (b + pad).replace(/-/g, '+').replace(/_/g, '/');
    var raw = atob(base64);
    var out = new Uint8Array(raw.length);
    for (var i = 0; i < raw.length; i++) out[i] = raw.charCodeAt(i);
    return out;
  }
})();
</script>

