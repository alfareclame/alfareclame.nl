<script>
(function () {
  'use strict';
  var form = document.getElementById('cheatsheet-form');
  var submitBtn = document.getElementById('cheatsheet-submit');
  var msgEl = document.getElementById('cheatsheet-msg');
  var downloadWrap = document.getElementById('download-wrap');
  if (!form) return;

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var email = (form.elements['email'].value || '').trim();
    var consent = form.elements['consent'].checked;
    var honeypot = (form.elements['website'].value || '').trim();

    if (honeypot) return; // silent bot trap
    if (!email || !consent) {
      showMsg('Vul uw e-mailadres in en geef toestemming.', 'error');
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Verzenden…';
    msgEl.className = 'form-msg';
    msgEl.textContent = '';

    var lang = (form.elements['lang'] && form.elements['lang'].value) || 'nl';
    fetch('/api/lead-magnet', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: email, consent: true, website: honeypot, lang: lang })
    })
      .then(function (res) { return res.json(); })
      .then(function (data) {
        if (data && data.ok) {
          showMsg(data.message || 'Bedankt! Klik op de download-link hieronder.', 'success');
          if (data.download_url) {
            var link = document.getElementById('download-link');
            if (link) link.href = data.download_url;
          }
          downloadWrap.classList.add('visible');
          submitBtn.textContent = 'Verzonden ✓';
          form.elements['email'].disabled = true;
          form.elements['consent'].disabled = true;
        } else {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Stuur me de PDF';
          var errMsg = 'Er ging iets mis. Probeer het opnieuw of WhatsApp ons.';
          if (data && data.error === 'rate_limited') errMsg = 'U heeft recent al een aanvraag gedaan. Probeer over 2 minuten opnieuw.';
          if (data && data.error === 'invalid_email') errMsg = 'Ongeldig e-mailadres. Controleer en probeer opnieuw.';
          if (data && data.error === 'missing_consent') errMsg = 'Geef toestemming om door te gaan.';
          showMsg(errMsg, 'error');
        }
      })
      .catch(function () {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Stuur me de PDF';
        showMsg('Verbindingsfout. Probeer het opnieuw.', 'error');
      });
  });

  function showMsg(text, type) {
    msgEl.textContent = text;
    msgEl.className = 'form-msg form-msg--' + type;
  }
}());
</script>
