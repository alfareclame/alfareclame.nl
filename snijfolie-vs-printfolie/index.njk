            <td class="attr">Kleurspectrum</td>
            <td>60&ndash;100 vaste vinyl-kleuren</td>
            <td>Full-colour CMYK + wit, miljoenen tinten</td>
          </tr>
          <tr>
            <td class="attr">Geschikte content</td>
            <td>Logo, tekst, simpele iconen, grafiek</td>
            <td>Foto's, gradients, fotorealisme, illustratie</td>
          </tr>
          <tr>
            <td class="attr">Levensduur buiten</td>
            <td>8&ndash;10 jaar (cast-vinyl A-merk)</td>
            <td>5&ndash;7 jaar incl. laminaat</td>
          </tr>
          <tr>
            <td class="attr">Prijs (logo 1 m, 1&ndash;3 kleuren)</td>
