<!DOCTYPE html>
<html lang="nl-NL">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">

<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<meta name="keywords" content="{{ keywords }}">
<meta name="author" content="Alfa Reclame">
<meta name="robots" content="{{ robots | default("index, follow, max-snippet:-1, max-image-preview:large") }}">
<meta name="theme-color" content="#1D1D1F">
<meta name="color-scheme" content="light">

<meta name="geo.region" content="NL-ZH">
<meta name="geo.placename" content="Rotterdam">
<meta name="geo.position" content="51.96473;4.56910">
<meta name="ICBM" content="51.96473, 4.56910">

{%- set canonicalUrl = canonical or ("https://alfareclame.nl" + page.url) %}
<link rel="canonical" href="{{ canonicalUrl }}">
{%- if alternates %}
{%- for alt in alternates %}
<link rel="alternate" hreflang="{{ alt.hreflang }}" href="{{ alt.href }}">
{%- endfor %}
{%- else %}
<link rel="alternate" hreflang="nl" href="{{ canonicalUrl }}">
<link rel="alternate" hreflang="x-default" href="{{ canonicalUrl }}">
{%- endif %}

<link rel="icon" type="image/png" sizes="32x32" href="/public/images/favicon-32.png">
<link rel="icon" type="image/png" sizes="192x192" href="/public/images/favicon-192.png">
<link rel="apple-touch-icon" sizes="192x192" href="/public/images/favicon-192.png">

<meta property="og:site_name" content="Alfa Reclame">
<meta property="og:title" content="{{ og_title }}">
<meta property="og:description" content="{{ og_description }}">
<meta property="og:type" content="article">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:image" content="{{ og_image }}">
<meta property="og:image:width" content="{{ og_image_width | default("1200") }}">
<meta property="og:image:height" content="{{ og_image_height | default("630") }}">
<meta property="og:image:type" content="{{ og_image_type | default("image/jpeg") }}">
<meta property="og:locale" content="nl_NL">
<meta property="article:published_time" content="{{ article_published_time }}">
<meta property="article:modified_time" content="{{ page.inputPath | gitLastModified }}">
<meta property="article:author" content="Alfa Reclame">
<meta property="article:section" content="{{ article_section }}">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ twitter_title }}">
<meta name="twitter:description" content="{{ twitter_description }}">
<meta name="twitter:image" content="{{ og_image }}">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="dns-prefetch" href="https://wa.me">

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@200;300;400;500;600;700&family=Crimson+Pro:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">

<script type="application/ld+json">
{{ jsonld | renderContent("njk", { site: site }) | trim | safe }}
</script>

<style>
{{ pageStyles | trim | safe }}
.related-pages{margin:48px 0 24px;padding:24px;background:#F5F5F7;border-radius:12px}
.related-pages h2{font-size:18px;margin:0 0 16px;font-weight:600;color:#1D1D1F}
.related-pages__list{list-style:none;padding:0;margin:0;display:grid;gap:8px}
.related-pages__link{color:#0071E3;text-decoration:none;font-size:15px;line-height:1.5}
.related-pages__link:hover{text-decoration:underline}
</style>
</head>
<body>
{{ content | safe }}
{% include "related-pages.njk" %}
{% include "wa-float.njk" %}
</body>
</html>
