  <!-- BREADCRUMB{% if breadcrumbComment %}: {{ breadcrumbComment }}{% endif %} -->
  <div class="container">
    <nav class="breadcrumb" aria-label="Kruimelpad">
{%- for item in breadcrumbs %}
      <span class="breadcrumb__item">
{%- if item.url %}
        <a class="breadcrumb__link" href="{{ item.url }}">{{ item.label }}</a>
{%- else %}
        <span class="breadcrumb__current">{{ item.label }}</span>
{%- endif %}
      </span>
{%- endfor %}
    </nav>
  </div>
