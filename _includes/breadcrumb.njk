{% if breadcrumbs %}<nav class="breadcrumb" aria-label="Kruimelpad">
  {% for item in breadcrumbs %}{% if item.url %}<a href="{{ item.url }}">{{ item.label }}</a>{% if not loop.last %}<span class="breadcrumb__sep" aria-hidden="true">/</span>{% endif %}{% else %}<span class="breadcrumb__current" aria-current="page">{{ item.label }}</span>{% endif %}{% endfor %}
</nav>{% endif %}
