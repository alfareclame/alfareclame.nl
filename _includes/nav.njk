<header class="nav" role="banner">
  <div class="nav__inner">
    <a class="nav__logo" href="/" aria-label="Alfa Reclame homepage">
      <img src="/public/images/logo.png" alt="Alfa Reclame logo" width="124" height="40" loading="eager" decoding="async">
    </a>

    <nav class="nav__links" role="navigation" aria-label="Hoofdnavigatie">
{%- if page.url == "/" %}
      <a class="nav__link nav__link--active" href="/" aria-current="page">Home</a>
{%- endif %}
      <a class="nav__link{% if navActiveUrl == "/diensten/" %} nav__link--active{% endif %}" href="/diensten/"{% if page.url == "/diensten/" %} aria-current="page"{% endif %}>Diensten</a>
      <a class="nav__link{% if navActiveUrl == "/raambelettering-rotterdam/" %} nav__link--active{% endif %}" href="/raambelettering-rotterdam/"{% if page.url == "/raambelettering-rotterdam/" %} aria-current="page"{% endif %}>Raambelettering</a>
      <a class="nav__link{% if navActiveUrl == "/autoreclame-rotterdam/" %} nav__link--active{% endif %}" href="/autoreclame-rotterdam/"{% if page.url == "/autoreclame-rotterdam/" %} aria-current="page"{% endif %}>Autoreclame</a>
      <a class="nav__link{% if navActiveUrl == "/gevelreclame-rotterdam/" %} nav__link--active{% endif %}" href="/gevelreclame-rotterdam/"{% if page.url == "/gevelreclame-rotterdam/" %} aria-current="page"{% endif %}>Gevelreclame</a>
{%- if navExtraLink and navExtraLink.position != "after-over-ons" %}
      <a class="nav__link{% if navActiveUrl == navExtraLink.url %} nav__link--active{% endif %}" href="{{ navExtraLink.url }}"{% if page.url == navExtraLink.url %} aria-current="page"{% endif %}>{{ navExtraLink.label }}</a>
{%- endif %}
      <a class="nav__link{% if navActiveUrl == "/over-ons/" %} nav__link--active{% endif %}" href="/over-ons/"{% if page.url == "/over-ons/" %} aria-current="page"{% endif %}>Over ons</a>
{%- if navExtraLink and navExtraLink.position == "after-over-ons" %}
      <a class="nav__link{% if navActiveUrl == navExtraLink.url %} nav__link--active{% endif %}" href="{{ navExtraLink.url }}"{% if page.url == navExtraLink.url %} aria-current="page"{% endif %}>{{ navExtraLink.label }}</a>
{%- endif %}
    </nav>

    <div class="nav__cta">
      <a class="btn btn-primary btn--sm" href="tel:+31624741597" aria-label="Bel Alfa Reclame direct op +31 6 24 74 15 97">
        Bel ons
      </a>
    </div>

    <button class="nav__toggle" aria-label="Menu openen" aria-expanded="false" aria-controls="mobile-nav" id="nav-toggle">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>
